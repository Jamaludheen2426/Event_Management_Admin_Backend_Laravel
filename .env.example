APP_NAME="Event Management API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# New database, built only by Laravel migrations
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=event_laravel
DB_USERNAME=root
DB_PASSWORD=
# true for Aiven (SSL without a CA file)
DB_SSL=false

# Old Node database, read only (php artisan legacy:import, legacy tests)
LEGACY_DB_SSL=false
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=event_
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Tenancy: vendor #1 is the house vendor (ours)
HOUSE_COMPANY_ID=1
HOUSE_VENDOR_ID=1

# Local only: `php artisan db:seed` creates this developer login (ignored in production).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Browser origins allowed to send cookies, comma separated
FRONTEND_URL=http://localhost:3000,http://localhost:3001

# base64 of the 32-byte AES key the Node API derived with
#   node -e "console.log(require('crypto').scryptSync(process.env.EVENT_QR_SECRET,'event-qr-v1',32).toString('base64'))"
# Use the SAME secret the Node API used in that environment, or printed QR codes stop working.
EVENT_QR_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_URL=

MYMEMORY_EMAIL=
# Pause between machine-translation requests when translating a whole site (ms).
MYMEMORY_DELAY_MS=350
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
OAUTH_CALLBACK_BASE_URL=
PUBLIC_SITE_ROOT_DOMAINS=
TWO_FACTOR_ISSUER="Event Invit"

MSG91_WA_AUTHKEY=
MSG91_WA_NUMBER=
MSG91_OTP_TEMPLATE=
MSG91_OTP_ENABLED=
MSG91_SMS_AUTHKEY=
MSG91_SMS_FLOW_ID=
MSG91_SMS_VAR=
MSG91_SMS_APP_HASH_VAR=
MSG91_SMS_APP_HASH=
MSG91_SMS_OTP_ENABLED=
OTP_DEV_ECHO=
OTP_ACCEPT_ANY=false

# Card payments: set one provider to let clients save tokenised cards.
# Empty = clients record manual payment methods only (v1 behaviour).
RAZORPAY_KEY_ID=
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# ffmpeg for gallery / wish videos (make playable, mute, poster). Missing =
# videos are stored as uploaded and a requested mute is refused.
FFMPEG_PATH=ffmpeg

# E-mail goes out through Settings -> Email's default provider ("configured"
# mailer); with none set, e-mails are written to the log.
MAIL_MAILER=configured

# Chat socket relay (chat-socket/): where it listens for Laravel's pushes, and
# the secret both sides share. Run it with LARAVEL_URL + the same secret.
CHAT_SOCKET_URL=http://127.0.0.1:3005
CHAT_SOCKET_SECRET=
